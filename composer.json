{
    "name": "amadulhaque/shopify-bridge",
    "description": "A contract-driven Shopify package for Laravel.",
    "keywords": [
        "laravel",
        "shopify",
        "graphql",
        "oauth",
        "webhooks"
    ],
    "homepage": "https://github.com/amadulhaque/shopify-bridge",
    "support": {
        "issues": "https://github.com/amadulhaque/shopify-bridge/issues",
        "source": "https://github.com/amadulhaque/shopify-bridge"
    },
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Amadulhaque\\Shopify\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Amadulhaque\\Shopify\\Providers\\ShopifyServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    }
}
